---
import {ProjectsView} from "@/components/projects/ProjectsView/ProjectsView";
import GlobalLayout from "@/layouts/GlobalLayout.astro";
import styles from "./projects.module.scss"
import ResponsiveWrapper from "@/components/ui/ResponsiveWrapper/ResponsiveWrapper.astro";
import { ChevronLeft } from "lucide-react";
import {useTranslation} from "@/i18n/utils.ts";

export function getStaticPaths() {
    return [
        {params: {locale: 'en'}},
        {params: {locale: 'fr'}},
    ];
}

export const prerender = true;
const {locale, t} = useTranslation(Astro.url)
---

<GlobalLayout title={"Ben Gaudry - " + t("projects.title")}>
    <div class={styles.Projects}>
        <ResponsiveWrapper withMargin isFirst>
            <a href={`/${locale}/`} class={styles.BackButton}>
                <ChevronLeft size={24}/>
                {t('common.back')}
            </a>
            <h1>{t('projects.title')}</h1>
            <ProjectsView defaultProjectId={Astro.url.searchParams.get("modal-content-id")} client:only="react"/>
        </ResponsiveWrapper>
    </div>
</GlobalLayout>
