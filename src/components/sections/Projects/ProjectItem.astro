---
import type {ProjectProps} from "@/lib/projects.ts";
import styles from "@/components/sections/Projects/Projects.module.scss";
import {List} from "@/components/ui";
import {getLocaleFromUrl} from "@/i18n/utils.ts";

type Props = { project: ProjectProps };

const locale = getLocaleFromUrl(Astro.url)

const {
    id,
    title,
    description,
    imgSrc,
    iconSrc,
} = Astro.props.project;
---

<a href={`/${locale}/projects?modal-content-id=${encodeURIComponent(id)}`}>
    <List className={styles.ProjectItem} title={title} iconUrl={iconSrc} forceIcon={!iconSrc}>
        <article>
            <img
                    src={imgSrc}
                    class={styles.ProjectPicture}
                    loading="lazy"
                    width={350}
                    height={(350 * 9) / 16}
                    alt={`${title} screenshot`}
            />

            <p>{description}</p>
        </article>
    </List>
</a>